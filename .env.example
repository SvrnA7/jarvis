# Sprachausgabe: browser (kostenlos, Standard), elevenlabs oder fish
TTS_PROVIDER=browser
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...
# FISH_API_KEY=...
# FISH_VOICE_ID=...

# Modell des "Gehirns" (Claude Code CLI): sonnet, opus, haiku
JARVIS_BRAIN_MODEL=sonnet
# Wie Jarvis dich anspricht
USER_NAME=Sven
# Zum Testen ohne Claude: 1 = Jarvis wiederholt nur, was du sagst
# JARVIS_FAKE_BRAIN=1

# Einnahmen deiner Apps (RevenueCat, nur lesend): v2-Secret-Key mit Leserechten
# für "Project configuration" und "Charts & metrics". Mehrere Projekte: kommagetrennt.
# REVENUECAT_API_KEY=sk_...
# REVENUECAT_CURRENCY=EUR
